# =============================================================================
# Muse AI Gateway API - environment configuration
# Copy to `.env` and adjust. Variables marked REQUIRED have no default.
# =============================================================================

# ---- Server -----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Public URL clients use to reach this API (used to build signed media URLs).
PUBLIC_BASE_URL=https://api.example.com
# Number of reverse proxies in front of the app (nginx = 1).
TRUST_PROXY=1
# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*
# Max JSON body size (base64 reference media is sent inline).
JSON_BODY_LIMIT=40mb
# Time allowed for in-flight jobs to finish on shutdown.
SHUTDOWN_GRACE_MS=30000
# Unique node identifier (defaults to hostname-pid).
# NODE_ID=api-1

# ---- Database (REQUIRED) ----------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/muse_api
MONGODB_MAX_POOL_SIZE=50

# ---- Security (REQUIRED) ----------------------------------------------------
# Master admin key (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=
# HMAC secret for signed media URLs (>= 32 chars).
SIGNING_SECRET=
# Lifetime of signed media URLs, in seconds (default 24h).
SIGNED_URL_TTL_SEC=86400
# Optional bearer token for GET /metrics (the admin key also works).
METRICS_TOKEN=

# ---- Rate limiting ----------------------------------------------------------
# Default requests/minute per API key (overridable per key).
RATE_LIMIT_PER_MINUTE=120
# Requests/minute per client IP (pre-authentication flood protection).
IP_RATE_LIMIT_PER_MINUTE=600
# Default max queued+running jobs per API key (overridable per key).
DEFAULT_MAX_CONCURRENT_JOBS=20

# ---- Storage ----------------------------------------------------------------
STORAGE_DIR=./storage
# Uploaded and generated files are deleted after this many hours.
FILE_RETENTION_HOURS=168
MAX_IMAGE_MB=20
MAX_VIDEO_MB=100
# Allow reference media to be fetched from public http(s) URLs.
ALLOW_REMOTE_MEDIA_URLS=true
REMOTE_FETCH_TIMEOUT_MS=20000

# ---- Upstream account pool --------------------------------------------------
# Only accounts whose "group" equals this value are served by this node.
ACCOUNT_GROUP=
# Default concurrent requests per account, per capability.
ACCOUNT_CHAT_CONCURRENCY=4
ACCOUNT_IMAGE_CONCURRENCY=2
ACCOUNT_VIDEO_CONCURRENCY=1
# Max slot wait; 0 waits until capacity is free or the caller disconnects.
CHAT_SLOT_WAIT_MS=0
# Interval (minutes) for credential keep-alive / auto-renewal.
KEEPALIVE_INTERVAL_MIN=15
# Circuit breaker cooldown after repeated account failures.
ACCOUNT_COOLDOWN_BASE_MS=30000
ACCOUNT_COOLDOWN_MAX_MS=900000

# ---- Jobs -------------------------------------------------------------------
# Global cap on queued + running jobs (503 queue_full beyond this).
QUEUE_MAX_PENDING=2000
# Attempts per job (retries happen on a different account).
JOB_MAX_ATTEMPTS=2
DISPATCHER_POLL_MS=1000
JOB_HEARTBEAT_STALE_MS=90000
# Max time a synchronous request waits before falling back to 202 Accepted.
SYNC_WAIT_MAX_MS=150000
IMAGE_TIMEOUT_MS=180000
# Queue deadlines: 0 waits for capacity without timing out in the queue.
IMAGE_QUEUE_TIMEOUT_MS=0
VIDEO_TIMEOUT_MS=300000
VIDEO_QUEUE_TIMEOUT_MS=0
CHAT_TIMEOUT_MS=120000

# ---- Webhooks ---------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
# Allow webhooks to private/loopback addresses (development only).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ---- Browser Automation (Chromium WSS extraction) ---------------------------
# Path to Chromium/Chrome binary. If unset, automatically detects on Linux & Windows.
# CHROMIUM_PATH=/usr/bin/chromium-browser
# CHROMIUM_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# BROWSER_TIMEOUT_MS=35000
# BROWSER_HEADLESS=true

# ---- Bulk account import (Redis queue) --------------------------------------
# Redis for the bulk import queue; docker-compose sets it to redis://redis:6379.
# Leave empty to disable bulk import.
REDIS_URL=
# Pause between two imported accounts.
ACCOUNT_IMPORT_INTERVAL_SEC=20
ACCOUNT_IMPORT_MAX_PER_BATCH=500
# Max time one account may hold the queue.
ACCOUNT_IMPORT_ITEM_TIMEOUT_SEC=240
# How long batch status (no cookies) is kept.
ACCOUNT_IMPORT_RETENTION_HOURS=168

# ---- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Level used for verbose upstream protocol logs.
UPSTREAM_LOG_LEVEL=debug
